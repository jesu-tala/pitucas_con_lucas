{
  "compilerOptions": {
    "target": "ES2019",
    "lib": ["ES2019", "DOM"],
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "outDir": "dist",
    "rootDir": "src",
    "strict": false,
    "noImplicitAny": false,
    "checkJs": false,
    "skipLibCheck": true,
    "removeComments": false,
    "sourceMap": false,
    "noEmitOnError": true,
    "newLine": "lf"
  },
  "include": ["src/**/*.ts"]
}
